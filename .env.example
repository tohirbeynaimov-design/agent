# ===== Agent UZ sozlamalari =====
# Bu faylni .env nomi bilan nusxalang va qiymatlarni o'zgartiring:  cp .env.example .env

# Ilova nomi (sarlavha va logotip yonida ko'rinadi)
APP_NAME="Agent UZ"

# Saytingiz domeni (HTTPS sertifikati avtomatik olinadi). Domen hali bo'lmasa: DOMAIN=:80
DOMAIN=buyurtma.example.uz

# Super admin: faqat admin hisoblarini boshqaradi. Kirish sahifasi: https://DOMEN/super
# Birinchi ishga tushishda yaratiladi; keyin parolni super admin panelidagi "Profil"dan o'zgartirasiz.
SUPERADMIN_LOGIN=Tohirbey1
SUPERADMIN_PASSWORD=

# Ixtiyoriy: birinchi adminni ham avtomatik yaratish (odatda adminlarni super admin qo'shadi)
# ADMIN_PHONE=998901234567
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# Qo'shimcha (odatda o'zgartirish shart emas)
# PORT=3000
# DATA_DIR=./data
# TZ=Asia/Tashkent
# SESSION_DAYS=30
